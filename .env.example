# Illustrative values only; consult the upstream Karakeep documentation.
NEXTAUTH_URL=http://localhost:3002
# Generate a fresh secret for your own deployment; never commit the actual value.
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional experimental local inference.
# These settings require an OpenAI-compatible server reachable from Docker.
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://host.docker.internal:8091/v1
INFERENCE_TEXT_MODEL=REPLACE_WITH_YOUR_MODEL_ID
